# Copy to keystore.properties (gitignored) and point at your release keystore.
storeFile=/path/to/release.jks
storePassword=
keyAlias=taildeck
keyPassword=
# Optional: rotate from an older signing key so existing installs can upgrade.
#legacyStoreFile=/path/to/old.keystore
#legacyStorePassword=
#legacyKeyAlias=
#legacyKeyPassword=
#lineageFile=/path/to/lineage.bin
